# FootBot Environment Variables Configuration

# OpenAI API Key for GPT-based tactical analysis
OPENAI_API_KEY=your-openai-api-key-here

# LLM Configuration
# Any model id your provider exposes, e.g. gpt-4o-mini on OpenAI, or an
# OpenRouter slug such as nvidia/nemotron-3-super-120b-a12b:free when
# OPENAI_API_KEY is an OpenRouter key (sk-or-...). Pin a specific model rather
# than a router alias, otherwise each request may be served by a different one.
OPENAI_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7

# Seconds to wait on a single LLM call before giving up (SDK default is 600).
# This is a ceiling on a hung request, not a target: squad generation on a free
# model has been measured at ~140s, so don't set it near that or working calls
# get cut off and retried.
LLM_REQUEST_TIMEOUT_SECONDS=300

# API-Football key, used for fixtures, lineups, match events and team crests.
# Get one at https://dashboard.api-football.com. Optional: without it the app
# falls back to scraping and LLM-generated rosters. Note the free tier allows
# only 10 requests/minute; requests are throttled to stay under that.
API_FOOTBALL_KEY=your-api-football-key-here

# RAG Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Path Configuration (relative to workspace or absolute)
FAISS_DB_PATH=./data/embeddings
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# Backend Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Auth session tokens issued on /login and /register (seconds; default 30 days)
SESSION_TOKEN_TTL_SECONDS=2592000

# Legacy single-tenant demo account, originally used by the retired Streamlit
# client, which had no login screen. Set a password to keep access to chat
# history saved under it before the session-token migration; leave unset to
# disable the account entirely. No default is provided on purpose - pick your
# own password, don't reuse this example.
FOOTBOT_LEGACY_DEMO_USERNAME=default_coach
FOOTBOT_LEGACY_DEMO_PASSWORD=
