# FootBot Environment Variables Configuration

# OpenAI API Key for GPT-based tactical analysis
OPENAI_API_KEY=your-openai-api-key-here

# LLM Configuration
# Options: gpt-4o-mini (recommended), gpt-4o, gpt-3.5-turbo
OPENAI_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7

# RAG Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Path Configuration (relative to workspace or absolute)
FAISS_DB_PATH=./data/embeddings
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# Backend Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Auth session tokens issued on /login and /register (seconds; default 30 days)
SESSION_TOKEN_TTL_SECONDS=2592000

# Legacy single-tenant demo account used by frontend/app.py, which has no login
# screen of its own. Required (backend and frontend both read it) to preserve
# access to chat history saved before the session-token migration; leave unset
# to disable this account entirely. No default is provided on purpose - pick
# your own password, don't reuse this example.
FOOTBOT_LEGACY_DEMO_USERNAME=default_coach
FOOTBOT_LEGACY_DEMO_PASSWORD=
